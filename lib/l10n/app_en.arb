  "homileticContentHelpTitle": "Content Summaries",
  "@homileticContentHelpTitle": {
    "description": "Title of the help dialog for the Content step."
  },
  "homileticContentHelpText": "A content summary is a summary of a section of the Bible. It doesn't need to be a sentence, it can also be more than one sentence. It should be a summary, in your own words, of the content of the passage.\nYou should have at least 10, but no more than 20 content summaries. Generally, depending on the length of the passage, you will divide your passage into chunks of an approximate size to hit the 10-20 mark. So, if your passage is 30 verses, I'd try for 3 verses per content summary on average.",
  "@homileticContentHelpText": {
    "description": "Help dialog text for the Content step. Keep the line break."
  },
  "homileticDivisionsHelpText": "Divisions are groupings of verses that are related. There should be at least two and no more than four.",
  "@homileticDivisionsHelpText": {
    "description": "Help dialog text for the Divisions step."
  },
  "homileticSummaryHelpTitle": "Summary Sentence",
  "@homileticSummaryHelpTitle": {
    "description": "Title of the help dialog for the Summary sentence step."
  },
  "homileticSummaryHelpText": "The Summary Sentence is a concise, memorable statement that encapsulates the most relevant facts. A good way of thinking of it is the 2am test: if someone were to wake you up at 2am and ask you what the sermon was about, what would you say? You'd say the Summary Sentence.\nIt should be 10 words or fewer. If you're feeling frisky, you can try to make an alliteration.",
  "@homileticSummaryHelpText": {
    "description": "Help dialog text for the Summary sentence step. Keep the line break; the word limit may be adapted for languages where 10 words is unnatural."
  },
  "homileticFcfHelpText": "The FCF (Fallen Condition Focus) is the part of humanity that is the most illustrated or referenced in the passage. It is the condition that the audience is in, the reason that the audience needs to be saved.",
  "@homileticFcfHelpText": {
    "description": "Help dialog text for the FCF step."
  },
  "homileticAimHelpText": "The Aim is the key point, the one main takeaway truth you want yourself or an audience to walk away with. It may be derivable from the FCF, and will likely influence the Application Questions.",
  "@homileticAimHelpText": {
    "description": "Help dialog text for the Aim step."
  },
  "homileticApplicationHelpTitle": "Application Questions",
  "@homileticApplicationHelpTitle": {
    "description": "Title of the help dialog for the Application step."
  },
  "homileticApplicationHelpText": "These are questions that help the audience apply what they've just heard to their own lives. They should be specific, personal, open-ended, and thought-provoking.",
  "@homileticApplicationHelpText": {
    "description": "Help dialog text for the Application step."
  },
