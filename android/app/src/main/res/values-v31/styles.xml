<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the launch screen itself: the app's ground, the
         animated "H." mark (drawn whole, so the system's circle doesn't
         crop the icon) and the 13one.org line at the bottom. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">820</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="android:windowBackground">@color/splash_ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ground</item>
    </style>
</resources>
